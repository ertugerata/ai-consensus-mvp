# API Keys Configuration (Optional - Can also be configured dynamically in the UI)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# System Access Token (Optional - Set on the server to require token authentication for all API endpoints)
API_ACCESS_TOKEN=

# SSRF Security & Private Network Access
# Set ALLOW_PRIVATE_IPS=true to allow access to local/private IP ranges (192.168.x.x, 10.x.x.x, 172.16.x.x, 127.0.0.1)
ALLOW_PRIVATE_IPS=false
# Or specify allowed hostnames/IPs separated by commas (e.g. 192.168.1.50,192.168.1.50:5055,my-notebook.local)
OPEN_NOTEBOOK_ALLOW_LIST=

# Local Ollama Provider URL (Optional - Set on the server)
# Use http://localhost:11434 for local development, or http://host.docker.internal:11434 for Docker Compose
OLLAMA_BASE_URL=http://localhost:11434

# Application Public URL
APP_URL=http://localhost:3000
